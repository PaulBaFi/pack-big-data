---
import Layout from './Layout.astro';
import { Header } from '../components/Header';
import { Sidebar } from '../components/Sidebar';

interface Props {
  title: string;
  activeSection?: string;
  fullWidth?: boolean;
}

const { title, activeSection, fullWidth = false } = Astro.props;
const currentPath = Astro.url.pathname;
const user = Astro.locals.user;
---

<Layout title={title}>
  <div class="grid md:grid-cols-[256px_1fr] min-h-screen">
    <Sidebar currentPath={currentPath} client:load />
    <div class="flex flex-col min-w-0 min-h-screen">
      <Header user={user} activeSection={activeSection} client:load />
      <main class:list={[
        'flex-1 w-full mx-auto',
        fullWidth
          ? 'flex flex-col min-h-[calc(100vh-4rem)] max-w-none p-3 md:p-4'
          : 'p-6 lg:p-8 max-w-7xl space-y-6',
      ]}>
        <slot />
      </main>
    </div>
  </div>
</Layout>
