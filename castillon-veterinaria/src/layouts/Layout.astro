---
import "@/styles/global.css";

interface Props {
	title: string;
	desc?: string;
}

const { title, desc } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={desc} />
		
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<title>{title}</title>
	</head>
	<body><slot /></body>
</html>
